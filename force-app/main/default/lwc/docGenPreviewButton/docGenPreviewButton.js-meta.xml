<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- Modified by Dura Composites Ltd. -->
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>DocGen Preview Button</masterLabel>
    <description
    >Opens a DocGen document in Salesforce's file preview with no dialog. Uses the record's first active DocGen Button whose Delivery Mode is Preview. Use as a record quick action.</description>
    <targets>
        <target>lightning__RecordAction</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordAction">
            <actionType>Action</actionType>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
